# ---- Kafka Connect endpoint ----
CONNECT_URL=http://172.20.20.173:8083/connectors
CONNECT_SERVICE=kafka_connect

# ---- Connector identity ----
CONNECTOR_NAME=mysql-connector-lastdb
TASKS_MAX=1

# ---- MySQL source ----
MYSQL_HOST=lastdb
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=secret

# Debezium logical server identity (namespace for topics)
MYSQL_SERVER_NAME=lastdb
# Use a unique ID per connector to avoid collisions
DATABASE_SERVER_ID=1001

# Filter scopes
MYSQL_DATABASE=lastsecondb
MYSQL_TABLES=lastsecondb.agencies,lastsecondb.airlines,lastsecondb.hotels,lastsecondb.ignores,lastsecondb.amenity_hotel,lastsecondb.comments,lastsecondb.posts,lastsecondb.categories,lastsecondb.media,lastsecondb.locations,lastsecondb.badges,lastsecondb.users,lastsecondb.labels,lastsecondb.settings,lastsecondb.pages,lastsecondb.faqs,lastsecondb.videos,lastsecondb.bulletins,lastsecondb.amenities,lastsecondb.facilities,lastsecondb.textads,lastsecondb.competes,lastsecondb.competitions,lastsecondb.landingpages,lastsecondb.listings,lastsecondb.listables,lastsecondb.attractions,lastsecondb.attractiontypes,lastsecondb.attraction_attractiontype,lastsecondb.facility_restaurant,lastsecondb.restaurants,lastsecondb.video_qualities,lastsecondb.badge_user,lastsecondb.tour_request_online_terms,lastsecondb.travelogues,lastsecondb.location_post,lastsecondb.location_video,lastsecondb.location_travelogue,lastsecondb.airports,lastsecondb.restauranttypes,lastsecondb.utilities,lastsecondb.chains,lastsecondb.reviews,lastsecondb.parameters,lastsecondb.location_parameter,lastsecondb.parameter_review,lastsecondb.features,lastsecondb.restaurant_restauranttype,lastsecondb.mediables,lastsecondb.likes,lastsecondb.spot_ranks,lastsecondb.attraction_utility,lastsecondb.feature_review,lastsecondb.feature_location

# ---- Topic naming ----
TOPIC_PREFIX=lastdb

# ---- Kafka & history topics ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

SCHEMA_HISTORY_INTERNAL_KAFKA_TOPIC=schemahistory.lastdb
SCHEMA_HISTORY_INTERNAL_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

DATABASE_HISTORY_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
DATABASE_HISTORY_KAFKA_TOPIC=dbhistory.lastdb

# ---- Converters ----
KEY_CONVERTER=org.apache.kafka.connect.json.JsonConverter
KEY_CONVERTER_SCHEMAS_ENABLE=false
VALUE_CONVERTER=org.apache.kafka.connect.json.JsonConverter
VALUE_CONVERTER_SCHEMAS_ENABLE=false

# ---- Transforms ----
TRANSFORMS=unwrap
TRANSFORMS_UNWRAP_TYPE=io.debezium.transforms.ExtractNewRecordState
TRANSFORMS_UNWRAP_DROP_TOMBSTONES=true
TRANSFORMS_UNWRAP_DELETE_HANDLING_MODE=rewrite
TRANSFORMS_UNWRAP_ADD_FIELDS=op

# ---- Producer overrides ----
PRODUCER_OVERRIDE_MAX_REQUEST_SIZE=20971520
